# ============================================================================
# VYZ · variáveis de ambiente · modelo. Copie para .env.local e preencha.
# ============================================================================

# ---- Supabase ---------------------------------------------------------------
# Settings > API Keys e Settings > Database no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública: pode ir para o navegador. Quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave de serviço: só no servidor, ignora o RLS. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Legado: JWT "anon" (equivale à chave pública acima). Não é usada pelo app.
SUPABASE_ANON_KEY_LEGACY=

# ---- Banco (migrations, tipos e scripts; nunca no app) -----------------------
# Pooler em modo sessão (IPv4). É a que funciona nesta rede.
SUPABASE_DB_URL=
# Conexão direta: o host só tem IPv6.
SUPABASE_DB_URL_DIRECT=

# ---- App --------------------------------------------------------------------
# Em produção: https://www.vyzualize.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# mock = sem credenciais (pagamento e OAuth simulados) · stripe / live = reais
BILLING_PROVIDER=mock
INTEGRATIONS_MODE=mock
# Bloqueia simulação em produção (true só para demonstração)
ALLOW_MOCKS_IN_PRODUCTION=false
# Bearer da sincronização agendada (/api/cron/sync), 16+ caracteres
CRON_SECRET=

# ---- Stripe (pendente) -------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- RevenueCat (compras no app nativo) ----
REVENUECAT_WEBHOOK_SECRET=

# ---- Meta / Facebook Login for Business (pendente) ---------------------------
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

# ---- Google (OAuth do Google Ads; pendente) ----------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
