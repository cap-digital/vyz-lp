# Copie para .env e preencha. EXPO_PUBLIC_* vai para dentro do app: só valores públicos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origem do app web (API /api/v1). No simulador iOS: http://localhost:3000; no Android: http://10.0.2.2:3000
# Produção: https://www.vyzualize.com.br
EXPO_PUBLIC_API_URL=http://localhost:3000
